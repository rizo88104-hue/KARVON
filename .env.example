# Copy to .env and fill in. .env is ignored by git.
# Read by docker-compose.yml and by the "dev" profile; in production set these as real environment variables.

# Spring profile: dev (local) or prod. Must be a real environment variable or a command-line
# argument; a value in .env cannot switch the profile because .env is loaded by the dev profile itself.
SPRING_PROFILES_ACTIVE=dev

# HTTP port (required in prod, 8080 by default in dev)
SERVER_PORT=8080

# PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_NAME=karvon
DB_USERNAME=karvon
DB_PASSWORD=change-me

# Redis (password is required in prod, not used by the local container)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT signing key (HS256), at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=

# Phone of the first ADMIN (+998XXXXXXXXX), created on startup if it does not exist
ADMIN_PHONE=

# Eskiz.uz SMS (prod only; the dev profile uses a fake sender that logs the text)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# Taobao API (prod only; dev uses fake products from src/main/resources/fake-taobao)
TAOBAO_API_URL=
TAOBAO_API_KEY=

# Translation (prod only; dev uses a small fake dictionary): google or yandex
TRANSLATION_PROVIDER=google
TRANSLATION_API_KEY=
YANDEX_FOLDER_ID=

# Payme Merchant API: Basic auth login (given by Payme support) and key (from the web cash desk), cash desk id
PAYME_LOGIN=
PAYME_KEY=
PAYME_MERCHANT_ID=
# https://checkout.paycom.uz in production; Payme gives a test checkout address for the sandbox
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

# Click SHOP API
CLICK_SECRET_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=

# Where customers return after paying (optional) and the public base URL of this API
PAYMENT_RETURN_URL=
PUBLIC_BASE_URL=http://localhost:8080
