# E-Market reverse proxy. ${...} values come from the environment (envsubst at container start); $name values are
# nginx variables. One certificate covers all domains (see docs/deploy.md, "TLS certificate").

server_tokens off;
client_max_body_size 21m;   # 4 parcel photos x 5 MB (+ form overhead); the API refuses larger JSON bodies itself

gzip on;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_proxied any;
gzip_vary on;
gzip_types text/plain text/css text/xml application/json application/javascript application/xml
           application/rss+xml image/svg+xml application/problem+json;

proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto https;
proxy_set_header X-Forwarded-Host $host;
proxy_set_header X-Request-Id $request_id;
proxy_set_header Connection "";
proxy_connect_timeout 5s;
proxy_read_timeout 60s;
proxy_send_timeout 60s;

ssl_certificate     /etc/nginx/ssl/fullchain.pem;
ssl_certificate_key /etc/nginx/ssl/privkey.pem;
ssl_protocols TLSv1.2 TLSv1.3;
ssl_prefer_server_ciphers off;
ssl_session_cache shared:SSL:10m;
ssl_session_timeout 1d;
ssl_session_tickets off;

upstream web_upstream { server web:3000; keepalive 16; }
upstream api_upstream { server api:8080; keepalive 16; }
upstream files_upstream { server minio:9000; keepalive 8; }

# ---- HTTP: Let's Encrypt challenges, everything else to HTTPS
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host${HTTPS_PORT_SUFFIX}$request_uri;
    }
}

# ---- Unknown host names over HTTPS: drop the connection
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    return 444;
}

# ---- www -> bare domain
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.${SITE_DOMAIN};
    return 301 https://${SITE_DOMAIN}${HTTPS_PORT_SUFFIX}$request_uri;
}

# ---- Site (customer pages and the staff panel at /admin)
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${SITE_DOMAIN};

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    # Browser API calls go straight to the API (same origin), so it sees the customer's IP.
    location /api/v1/ {
        proxy_pass http://api_upstream;
    }
    # Not for the public: the dev endpoints do not exist in prod anyway.
    location /api/v1/dev/ {
        return 404;
    }
    # Next.js build assets never change for a given file name.
    location /_next/static/ {
        proxy_pass http://web_upstream;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }
    location / {
        proxy_pass http://web_upstream;
    }
}

# ---- API: payment callbacks (Payme, Click), Telegram webhook, health
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${API_DOMAIN};

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location = /actuator/health {
        proxy_pass http://api_upstream;
    }
    location /actuator/health/ {
        proxy_pass http://api_upstream;
    }
    # Metrics and other actuator endpoints stay inside the Docker network.
    location /actuator/ {
        return 404;
    }
    location /api/v1/dev/ {
        return 404;
    }
    location / {
        proxy_pass http://api_upstream;
    }
}

# ---- Parcel photos (presigned MinIO links). The Host header must stay as signed.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${FILES_DOMAIN};

    location / {
        limit_except GET HEAD { deny all; }
        proxy_set_header Host $http_host;
        proxy_set_header Authorization "";
        proxy_buffering off;
        proxy_pass http://files_upstream;
    }
}
