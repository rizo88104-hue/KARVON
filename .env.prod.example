# E-Market production settings. Copy to .env.prod on the server (chmod 600) and fill in every value.
# .env.prod is NEVER committed (see .gitignore). Used by: docker compose --env-file .env.prod -f docker-compose.prod.yml
# Generate secrets with: openssl rand -hex 32

# ---------- Domains (all must point to the server's IP: A records) ----------
SITE_DOMAIN=karvon.uz
API_DOMAIN=api.karvon.uz
FILES_DOMAIN=files.karvon.uz
# Let's Encrypt account e-mail (expiry warnings)
LETSENCRYPT_EMAIL=admin@karvon.uz
# Public ports of nginx. Keep 80/443 in production (HTTPS_PORT_SUFFIX empty).
HTTP_PORT=80
HTTPS_PORT=443
HTTPS_PORT_SUFFIX=

# ---------- Images (GitHub Container Registry) ----------
# GitHub user or organization that owns the repositories, lower case
GHCR_OWNER=rizo88104-hue
# "latest" or a commit SHA (rollback: docs/deploy.md)
API_IMAGE_TAG=latest
WEB_IMAGE_TAG=latest

# ---------- PostgreSQL ----------
DB_NAME=karvon
DB_USERNAME=karvon
DB_PASSWORD=

# ---------- Redis ----------
REDIS_PASSWORD=

# ---------- MinIO (parcel photos and backups) ----------
MINIO_ROOT_USER=emarket
MINIO_ROOT_PASSWORD=
S3_REGION=us-east-1
S3_BUCKET=photos

# ---------- Backend ----------
# At least 32 characters; changing it logs everybody out
JWT_SECRET=
# First ADMIN user (+998XXXXXXXXX), created on startup
ADMIN_PHONE=
# Optional: "Baho qoldiring" link in the delivered SMS, e.g. a Google Maps review page; {number} = order number.
# Empty = the order page https://SITE_DOMAIN/account/orders/{number}
REVIEW_URL=
# Bearer token for /actuator/prometheus (only reachable inside the Docker network)
METRICS_TOKEN=

# SMS is off for now: login codes and notifications go by Telegram (or in-app). true = Eskiz SMS again
SMS_ENABLED=false
# Eskiz.uz SMS (only needed with SMS_ENABLED=true)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
# Sender name/number approved by Eskiz (4546 = Eskiz test sender)
ESKIZ_FROM=4546

# Telegram bot (login codes and customer notifications; webhook /api/v1/telegram/webhook)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Taobao API (catalog)
TAOBAO_API_URL=
TAOBAO_API_KEY=

# Translation: google or yandex
TRANSLATION_PROVIDER=google
TRANSLATION_API_KEY=
YANDEX_FOLDER_ID=

# Payme Merchant API (test keys first, then production: docs/deploy.md)
PAYME_LOGIN=Paycom
PAYME_KEY=
PAYME_MERCHANT_ID=
# Test: https://test.paycom.uz  Production: https://checkout.paycom.uz
PAYME_CHECKOUT_URL=https://checkout.paycom.uz
# Payme servers' IPs/CIDRs, comma-separated (ask Payme support for the current list)
PAYME_ALLOWED_IPS=

# Click SHOP API
CLICK_SECRET_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
# Click servers' IPs/CIDRs, comma-separated (ask Click support for the current list)
CLICK_ALLOWED_IPS=

# ---------- Site ----------
# Fallback delivery time when the backend settings cannot be loaded, e.g. 12–18 (optional)
NEXT_PUBLIC_DELIVERY_DAYS=

# ---------- Sentry (optional; one project per app) ----------
SENTRY_DSN_API=
SENTRY_DSN_WEB=
SENTRY_ENVIRONMENT=production
# Browser DSN is baked into the web image at build time: set it as a GitHub Actions variable NEXT_PUBLIC_SENTRY_DSN.

# ---------- Backups ----------
# Host directory for the daily dumps (the second copy besides MinIO); keep it outside the Docker volumes
BACKUP_DIR=/var/backups/emarket
BACKUP_BUCKET=backups
BACKUP_RETENTION_DAYS=30
# cron syntax, Asia/Tashkent time
BACKUP_CRON=0 3 * * *
# Optional third copy off the server (any rclone S3 remote), e.g. offsite:emarket-backups
BACKUP_OFFSITE_REMOTE=
RCLONE_CONFIG_OFFSITE_TYPE=s3
RCLONE_CONFIG_OFFSITE_PROVIDER=Other
RCLONE_CONFIG_OFFSITE_ENDPOINT=
RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
RCLONE_CONFIG_OFFSITE_REGION=

# ---------- Alerts (deploy/scripts/disk-alert.sh) ----------
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
DISK_ALERT_PERCENT=85
